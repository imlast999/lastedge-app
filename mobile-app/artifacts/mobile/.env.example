# URL base de LastEdge App Gateway (IP LAN de tu PC + puerto 8080).
# Para emulador Android: http://10.0.2.2:8080
# Para móvil físico: http://<TU_IP_LAN>:8080 (ej. http://192.168.1.120:8080)
# Obtener IP en Windows: ipconfig  →  busca "Dirección IPv4"
EXPO_PUBLIC_API_URL=http://192.168.1.120:8080

# Token secreto de API (opcional)
EXPO_PUBLIC_API_SECRET=
