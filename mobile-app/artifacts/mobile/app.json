{
  "expo": {
    "name": "LastEdge",
    "slug": "lastedge",
    "version": "1.1.64",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lastedge",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#09090b"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "backgroundColor": "#09090b",
      "package": "com.lastedge.app",
      "usesCleartextTraffic": true,
      "versionCode": 64
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Lokeya.ttf",
            "./assets/fonts/Moderna.ttf"
          ]
        }
      ],
      "expo-web-browser",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ed02925d-c159-4eb9-adfd-b82871c2a3ef"
      }
    }
  }
}